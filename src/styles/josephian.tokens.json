  "semantic": {
    "$description": "Purpose-based tokens. Use these in designs and layouts",
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.ink.900}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.stone.500}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.stone.400}"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.burgundy.700}"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.cream.50}"
      }
    },
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.cream.100}"
      },
      "card": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "raised": {
        "$type": "color",
        "$value": "#ffffff"
      }
    },
