    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.cream.50}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.stone.400}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.stone.500}"
      },
      "link": {
        "$type": "color",
        "$value": "#c98a8f"
